{
  "mode": "All",
  "policyRule": {
    "if": {
      "allOf": [
        {
          "field": "type",
          "equals": "Microsoft.Resources/subscriptions/resourceGroups"
        },
        {
          "anyOf": [
            {
              "field": "tags['owner']",
              "exists": "false"
            },
            {
                "anyOf": [
                  { "field": "tags['owner']", "notContains": "@" },
                  { "field": "tags['owner']", "notContains": "." }
                ]
              }
          ]
        }
      ]
    },
    "then": {
      "effect": "deny"
    }
  }
  
}
